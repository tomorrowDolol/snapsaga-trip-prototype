{
  "name": "snapsaga-web",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "拾光 SnapSaga 出行原型 · 工程化版本（React + TS + Vite），与根目录单文件原型同源同数据",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/publish-entry.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard": "node scripts/guard.mjs",
    "e2e": "node e2e/run-all.mjs",
    "verify": "npm run build && npm run test && npm run guard && npm run e2e"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
